PORT=5000
NODE_ENV=production

# Supabase
SUPABASE_URL=https://tlkuulvmahjcrsaioylt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:abhishek%4020220189@db.ilznpjxdmppeyqicsbap.supabase.co:5432/postgres

# JWT
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_URL=https://cutnculturesalon.cloud

# Salon
SALON_NAME=Your Salon

# Admin seed (run npm run seed once)
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=Salon Admin

# WhatsApp session path
WHATSAPP_SESSION_PATH=./.wwebjs_auth

# Cron timezone
CRON_TIMEZONE=Asia/Kolkata

# Auto-init WhatsApp on server start
AUTO_INIT_WHATSAPP=true

# Retry WhatsApp initialization after disconnects (milliseconds)
WHATSAPP_RECONNECT_DELAY_MS=30000

# Puppeteer cache directory
PUPPETEER_CACHE_DIR=./.cache/puppeteer

# Puppeteer executable path (optional, use if Chrome/Chromium is preinstalled on host)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# PUPPETEER_CACHE_DIR=./.cache/puppeteer

# Cashfree Payment Gateway
# -------------------------------------------------------------------
# IMPORTANT: Environment + Keys MUST be MATCHING (sandbox keys ↔ sandbox env, production keys ↔ production env)
#
# SANDBOX / LOCALHOST DEVELOPMENT:
#   CASHFREE_ENV=sandbox
#   Get SANDBOX keys: Cashfree Merchant Dashboard → Test Mode → Developers → API Keys
#   Sandbox allows http://localhost URLs (no HTTPS required)
#
# PRODUCTION / LIVE DEPLOYMENT:
#   CASHFREE_ENV=production
#   Get PRODUCTION keys: Cashfree Merchant Dashboard → Live Mode → Developers → API Keys
#   FRONTEND_URL and BACKEND_URL MUST be https:// (e.g. https://your-domain.com)
# -------------------------------------------------------------------
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=replace-with-your-cashfree-app-id
CASHFREE_SECRET_KEY=replace-with-your-cashfree-secret-key

# Public backend base URL used for payment webhook notify_url
BACKEND_URL=https://cutnculturesalon.cloud/api

# Firebase Admin SDK (Server-side auth — for verifying Firebase ID tokens)
# -------------------------------------------------------------------
# Setup:
#   1. Open Firebase Console → https://console.firebase.google.com → your project
#   2. Project settings (gear icon) → Service accounts tab → Firebase Admin SDK
#   3. Click "Generate new private key" → download the JSON file
#   4. Copy fields from that JSON into the 3 variables below:
#
#      JSON key  →  Env var
#      project_id    FIREBASE_PROJECT_ID
#      client_email  FIREBASE_CLIENT_EMAIL
#      private_key   FIREBASE_PRIVATE_KEY  (paste the whole multi-line key, keep \n as literal \n — on some systems wrap in double-quotes)
#
# Leave all 3 empty to disable Firebase auth (the app falls back to legacy email+password login).
# -------------------------------------------------------------------
FIREBASE_PROJECT_ID=crma-27967
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@crma-27967.iam.gserviceaccount.com
