VITE_API_URL=http://localhost:5000/api
VITE_CASHFREE_MODE=sandbox
# Hostinger VPS production API:
# VITE_API_URL=https://cutnculturesalon.cloud/api
# VITE_CASHFREE_MODE=production

# Firebase Web SDK (Client-side auth — Google Sign-In and Email/Password)
# -------------------------------------------------------------------
# Setup:
#   1. Open Firebase Console → https://console.firebase.google.com → your project
#   2. Project Settings (gear) → Your apps → Add app → Web App (</> icon)
#   3. Enter an app nickname, check "Also set up Firebase Hosting" if desired, click Register app
#   4. From the generated "firebaseConfig" JS snippet, copy each key below:
#
#        Snippet field   →  Env var
#        apiKey             VITE_FIREBASE_API_KEY
#        authDomain         VITE_FIREBASE_AUTH_DOMAIN
#        projectId          VITE_FIREBASE_PROJECT_ID
#        storageBucket      VITE_FIREBASE_STORAGE_BUCKET
#        messagingSenderId  VITE_FIREBASE_MESSAGING_SENDER_ID
#        appId              VITE_FIREBASE_APP_ID
#        measurementId      VITE_FIREBASE_MEASUREMENT_ID  (optional, only if using Analytics)
#
# Enable providers (required before use):
#   - Firebase Console → Authentication → Sign-in method → Email/Password → Enable
#   - Firebase Console → Authentication → Sign-in method → Google → Enable (add support email)
#
# Add Authorized domains:
#   - Firebase Console → Authentication → Settings → Authorized domains → add localhost + your production domain
#
# Leave VITE_FIREBASE_API_KEY empty to disable Firebase auth on the frontend and fall back to legacy login.
# -------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSyBwPmTwHGp3r7us6J8tJ6aJjHCPrDKXyss
VITE_FIREBASE_AUTH_DOMAIN=crma-27967.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=crma-27967
VITE_FIREBASE_STORAGE_BUCKET=crma-27967.firebasestorage.app
